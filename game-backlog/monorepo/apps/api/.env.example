DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# IGDB game search (Add a game page). Credentials come from a Twitch app; see "IGDB setup" in the README.
# Leave unset to disable search: GET /api/igdb/search returns 503 and games can still be added by hand.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# E2E runs (`nx e2e @org/api-e2e`) serve the API with apps/api/.env.test instead.
# Copy these two lines into apps/api/.env.test (gitignored), then create and migrate it:
#   docker exec drizzle-postgres createdb -U postgres game_backlog_test
#   npm exec nx -- run db:db-migrate:test
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/game_backlog_test
# PORT=3333
